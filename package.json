{
  "name": "ambercon",
  "version": "0.1.0",
  "private": true,
  "description": "AmberCon NW v2 site",
  "license": "MIT",
  "author": "guy@wyrdrune.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggascoigne/amber.git"
  },
  "files": [],
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "boot": "pnpm -F acnw boot && pnpm -F acus boot",
    "dev:nw": "pnpm -F acnw dev",
    "build:nw": "pnpm -F acnw build",
    "dev:us": "pnpm -F acus dev",
    "build:us": "pnpm -F acus build",
    "db:generate": "DB_ENV=acnw pnpm -F server db:migrate:generate",
    "format": "oxfmt",
    "lint": "pnpm run eslint",
    "oxlint": "oxlint --type-aware --fix",
    "eslint": "eslint --cache --color '**/*.{[mc]js,[mc]ts,[jt]s,tsx}'",
    "preinstall": "npx only-allow pnpm",
    "pre-commit": "pnpm format:all && pnpm lint && pnpm tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "pnpm -r --sequential test:e2e",
    "tsc": "pnpm -r tsc"
  },
  "dependencies": {
    "dotenv": "18.0.4",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@amber/tsconfig": "workspace:*",
    "@ggascoigne/eslint-config": "^3.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "~30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "^1.85.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "supports-color": "11.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "./scripts/noForbiddenCode.sh",
      "oxfmt",
      "eslint"
    ],
    "*.{css,scss,json}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "prettier": {
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.3.0"
}
